<?php
/**
 * Modelo de configuracao LOCAL para executar a aplicacao contra SQL Server.
 *
 * Copie este arquivo para:
 *   app/config/servidor.local.php
 *
 * servidor.local.php e ignorado pelo Git. Nunca versione credenciais reais.
 */
return array(
    'app_env' => 'development',
    'app_base_path' => '/estrategia',

    // Banco usado pela aplicacao local.
    'db_driver' => 'sqlsrv',
    'db_host' => 'localhost', // Ex.: localhost, .\\SQLEXPRESS ou NOME-PC\\SQLEXPRESS
    'db_database' => 'NOME_DO_BANCO',

    // Recomendado no computador local quando o SQL Server aceita sua conta Windows.
    'db_auth_mode' => 'integrated',

    // Para autenticacao SQL, troque db_auth_mode para 'sql' e descomente:
    // 'db_username' => 'USUARIO_SQL',
    // 'db_password' => 'SENHA_SQL',

    // Em desenvolvimento o login local continua disponivel.
    'auth_provider' => 'legacy_file',
    'diagnostico_php_version' => '',
);

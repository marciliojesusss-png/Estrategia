# Segredos de ambiente locais. O modelo versionado não contém credenciais.
/.env
/.env.*
!/.env.example
/app/config/servidor.local.php

# Caches e arquivos temporarios
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
.phpunit.cache/
.phpunit.result.cache
.parcel-cache/
.vite/
.next/
node_modules/
/.playwright-mcp/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs da aplicacao e arquivos gerados em tempo de execucao
/storage/logs/*
!/storage/logs/.gitkeep
/storage/temporarios/*.pid
/logs/
*.log

# Snapshot local com dados exportados do SQL Server
/database/indicadores.sqlite
/database/indicadores.sqlite.tmp-*
/database/backups/*.sqlite
/database/sqlserver/migration-report.json

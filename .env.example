# Modelo mínimo para produção. Copie para .env e preencha os valores reais.
# Nunca versione senhas ou credenciais corporativas.

APP_ENV=production
APP_DEBUG=false
APP_BASE_PATH=/estrategia

# SQL Server
DB_DRIVER=pdo_sqlsrv
DB_AUTH_MODE=integrated
DB_CONNECTION=sqlsrv
SQLSERVER_HOST=SERVIDOR_SQL
SQLSERVER_DATABASE=BANCO_ESTRATEGIA
# Vazios: o PDO usa a identidade do Application Pool. Preencha ambos apenas
# quando a infraestrutura exigir autenticação SQL explícita.
SQLSERVER_USER=
SQLSERVER_PASSWORD=

# LDAP corporativo. REMOTE_USER é fornecido pelo IIS a cada requisição.
AUTH_PROVIDER=legacy_file
LDAP_LEGACY_PATH=C:/caminho/acessoldap/LDAP.php
LDAP_URI=ldaps://ldap.corporativo.interno:636
LDAP_BASE_DN=OU=Usuarios,DC=corp,DC=empresa,DC=interno
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_REQUIRE_TLS=true

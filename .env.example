# Modelo de produção/homologação. Copie para .env e preencha somente os
# valores específicos do ambiente. Nunca versione credenciais reais.

# Aplicação
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Sao_Paulo
APP_BASE_PATH=/estrategia

# Banco de dados SQL Server
DB_CONNECTION=sqlsrv
SQLSERVER_HOST=SERVIDOR_SQL
SQLSERVER_DATABASE=DB5319_IndicadoresEstrategicos
SQLSERVER_PORT=
# Deixe usuário e senha vazios para autenticação integrada pela identidade do
# Application Pool. Preencha-os somente quando a infraestrutura exigir.
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=no

# Autenticação corporativa: caminho externo ao repositório para o adaptador
# que fornece a identidade do empregado.
LDAP_PATH=C:/caminho/corporativo/acessoldap/LDAP.php

# Limites operacionais
SESSION_IDLE_TIMEOUT=1800
LOG_MAX_BYTES=5242880
UPLOAD_MAX_BYTES=10485760
UPLOAD_ALLOWED_EXTENSIONS=pdf,jpg,jpeg,png,xls,xlsx,doc,docx
API_MAX_PAYLOAD_BYTES=1048576

# Desenvolvimento local: use APP_ENV=development, DB_CONNECTION=sqlite e
# APP_BASE_PATH= (vazio). Opcionalmente, AUTH_LOCAL_USER=C000001 simula um
# administrador local. O script scripts/executar-projeto.ps1 já define os
# três primeiros valores automaticamente.
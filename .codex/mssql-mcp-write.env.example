# Copie este arquivo para mssql-mcp-write.env e preencha uma conta SQL
# dedicada ao banco local Estrategia. O arquivo real e ignorado pelo Git.
SERVER_NAME=localhost
DATABASE_NAME=Estrategia
SQL_USERNAME=
# Opcao 1: senha em texto local (arquivo ignorado pelo Git)
SQL_PASSWORD=
# Opcao 2, preferencial: senha cifrada e chave em arquivos locais protegidos
# SQL_PASSWORD_AES_FILE=mssql-mcp-write.credential
# SQL_PASSWORD_AES_KEY_FILE=mssql-mcp-write.key
SQL_PORT=1433
TRUST_SERVER_CERTIFICATE=true

